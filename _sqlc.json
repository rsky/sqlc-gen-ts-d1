{
  "version": "2",
  "plugins": [
    {
      "name": "ts-sqlstorage",
      "wasm": {
        "url": "file://bin/sqlc-gen-ts-do-sqlstorage.wasm",
        "sha256": "$WASM_SHA256"
      }
    }
  ],
  "sql": [
    {
      "schema": "schema.sql",
      "queries": "query.sql",
      "engine": "sqlite",
      "codegen": [
        {
          "out": "src/gen/sqlc",
          "plugin": "ts-sqlstorage",
          "options": {
            "workers-types": "experimental"
          }
        }
      ]
    }
  ]
}
